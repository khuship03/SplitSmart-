# --- Server ---
PORT=4000
NODE_ENV=development

# --- Database (matches docker-compose.yml) ---
DATABASE_URL="postgresql://splitsmart:splitsmart@localhost:5432/splitsmart?schema=public"

# --- Redis (matches docker-compose.yml) ---
REDIS_URL="redis://localhost:6379"

# --- Auth ---
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="7d"

# --- Plaid (Sandbox — free, get keys at https://dashboard.plaid.com) ---
PLAID_CLIENT_ID=""
PLAID_SECRET=""
PLAID_ENV="sandbox"

# --- OpenAI (pay-as-you-go, cheap at this scale) ---
OPENAI_API_KEY=""

# --- Frontend ---
VITE_API_URL="http://localhost:4000"
